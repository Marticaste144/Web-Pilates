# Supabase (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo se usa en server-side (route handlers / server actions
# con permisos elevados, ej. marcar pagos en efectivo). Nunca exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto de firma del webhook (Tus integraciones > tu app > Webhooks en el
# panel de Mercado Pago). Opcional pero recomendado -- sin esto, el webhook
# igual funciona (vuelve a pedirle el pago a la API de MP antes de creerle
# nada al request entrante) pero no puede verificar que la llamada sea
# realmente de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=
# Temporal, solo mientras se diagnostica un problema de firma del webhook --
# ver "Endpoint temporal de diagnóstico" en el README. Sin esto seteado,
# /api/mercadopago/debug-secret responde 404 siempre. Sacar esta variable Y
# el endpoint una vez resuelto.
MERCADOPAGO_DEBUG_TOKEN=

# Web Push (notificaciones) - se usa a partir del paso de notificaciones
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pública de la app (para redirects de MP y links en notificaciones)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
