# Supabase (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo se usa en server-side (route handlers / server actions
# con permisos elevados, ej. marcar pagos en efectivo). Nunca exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (notificaciones por email -- lugar liberado en lista de espera,
# cuota por vencer/vencida, avisos de la admin). Ver README para el paso a
# paso de cómo conseguir estos valores.
RESEND_API_KEY=
# Formato "Nombre <direccion@dominio>". Sin dominio propio verificado en
# Resend, usar "MUV Gimnasia Postural <onboarding@resend.dev>" -- funciona,
# pero solo entrega a la casilla con la que te registraste en Resend.
EMAIL_FROM=
# Protege /api/cron/revisar-cuotas: cualquier texto random largo. Vercel lo
# manda solo como "Authorization: Bearer <esto>" al llamar al cron -- no hay
# que configurar nada más en Vercel aparte de esta variable.
CRON_SECRET=

# URL pública de la app (para links en emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
